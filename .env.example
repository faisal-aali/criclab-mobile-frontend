# development | production
# Restart Metro after changing APP_ENV (`npx expo start -c`).
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Local FastAPI (same Wi-Fi as the phone). Simulator: http://127.0.0.1:8000
# Physical phone: ipconfig getifaddr en0 → http://THAT-IP:8000
EXPO_PUBLIC_API_BASE_DEV=http://127.0.0.1:8000

# Live lab. Required when APP_ENV=production (EAS production / preview).
EXPO_PUBLIC_API_BASE_PROD=https://your-lab-host.example
