{
  "expo": {
    "name": "CricLab",
    "slug": "criclab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "criclab",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05090a"
    },
    "ios": {
      "bundleIdentifier": "com.criclab.app",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "CricLab records bowling video for pose analysis and ball flight tracking.",
        "NSMicrophoneUsageDescription": "Microphone is used when you record a bowling clip.",
        "NSPhotoLibraryUsageDescription": "Choose a bowling video from your library to analyze.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.criclab.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#05090a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "CricLab records a bowling session for ball flight tracking.",
          "microphonePermission": "Microphone is used when you record a bowling session.",
          "recordAudioAndroid": true
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "CricLab records bowling video for pose analysis and ball flight tracking.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Microphone is used when you record a bowling clip.",
          "enableFrameProcessors": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05090a",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a bowling video from your library to analyze.",
          "cameraPermission": "CricLab records a bowling delivery for pose analysis.",
          "microphonePermission": "Microphone is used when you record a bowling clip."
        }
      ]
    ],
    "extra": {
      "apiBase": "http://192.168.1.15:8000",
      "router": {},
      "eas": {
        "projectId": "6b2d2fea-4112-41ce-95df-e6f56411ef00"
      }
    },
    "owner": "criclab-ais-team"
  }
}
